# Optional. Leave these unset for fully playable manual mode.
# All three variables are server-only. Never use a NEXT_PUBLIC_ prefix.
# Include /v1 in the base URL, but do not include /chat/completions.

# Ollama: start its server and choose an installed model from `ollama list`.
# SPELL_LLM_BASE_URL=http://localhost:11434/v1
# SPELL_LLM_MODEL=your-installed-model-name

# LM Studio: load a model, start the local server, and use its exact model ID.
# SPELL_LLM_BASE_URL=http://localhost:1234/v1
# SPELL_LLM_MODEL=your-loaded-model-id

# Azure OpenAI / Azure AI Foundry (v1 API): use your resource endpoint plus /openai/v1.
# The model is your deployment name. The key is sent in the api-key header.
# SPELL_LLM_BASE_URL=https://your-resource.openai.azure.com/openai/v1
# SPELL_LLM_MODEL=your-deployment-name
# SPELL_LLM_API_KEY=your-azure-key
# Optional. Needed only for the older deployments URL format; leave unset with /openai/v1
# (Azure rejects dated versions there). Example:
# SPELL_LLM_BASE_URL=https://your-resource.openai.azure.com/openai/deployments/your-deployment-name
# SPELL_LLM_API_VERSION=2025-04-01-preview

# Optional for any provider. Sent as reasoning_effort to reasoning models
# (for example minimal, low, medium, high). Leave unset for non-reasoning models.
# SPELL_LLM_REASONING_EFFORT=low

# Optional for local servers; required if your provider requires credentials.
# SPELL_LLM_API_KEY=
